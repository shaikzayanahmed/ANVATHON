# Deterministic local adjudication; use groq, gemini, or ollama only when configured.
LLM_PROVIDER=rule-based
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Set LLM_PROVIDER=groq to use Groq for extraction, entailment, and relationship explanations.
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=15
DATABASE_PATH=data/benchsplit.db
HOST=0.0.0.0
PORT=8000
